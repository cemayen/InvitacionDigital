@model InvitacionDigital.Models.RegistroFamiliaViewModel
@{
    ViewData["Title"] = "Registro de invitados";
}

<section class="sm:max-w-[600px] w-full mx-auto px-4 flex flex-col gap-14">
    <div class="flex items-center gap-3 justify-between">
        <a href="@Url.Action("Index","Dashboard")" class="text-arena font-medium text-xs flex  items-center gap-1">
            <svg class="fill-current w-3" viewBox="0 0 640 640">
                <path d="M41.4 342.6C28.9 330.1 28.9 309.8 41.4 297.3L169.4 169.3C178.6 160.1 192.3 157.4 204.3 162.4C216.3 167.4 224 179.1 224 192L224 256L560 256C586.5 256 608 277.5 608 304L608 336C608 362.5 586.5 384 560 384L224 384L224 448C224 460.9 216.2 472.6 204.2 477.6C192.2 482.6 178.5 479.8 169.3 470.7L41.3 342.7z"/>
            </svg>
            Atras
        </a>
        <h3 class="xs:text-4xl text-3xl text-center font-bold text-arena leading-125">Registro de invitados</h3>
        <div class="w-[47px]"></div>
    </div>
    <form asp-action="RegistroFamilia" method="post">
        <div asp-validation-summary="ModelOnly" class="text-red-700 mb-3"></div>
        <div class="flex flex-col gap-5 w-full">
            <div class="flex flex-col gap-1">
                <label asp-for="NombreFamilia" class="label">Nombre de la Familia</label>
                <input type="text" asp-for="NombreFamilia" class="input">
                <span asp-validation-for="NombreFamilia" class="text-red-900 text-xs"></span>
            </div>
            <div class="flex flex-col gap-1">
                <label asp-for="Username" class="label">Usuario Familia</label>
                <input type="text" asp-for="Username" class="input">
                <span asp-validation-for="Username" class="text-red-900 text-xs"></span>
            </div>
            <div class="flex flex-col gap-1">
                <label asp-for="Password" class="label">Contraseña</label>
                <div class="inputContraseña w-full relative">
                    <input type="password" asp-for="Password" class="input !pr-8">
                    <div class="w-5 absolute top-0 mt-3  mr-2 right-0" onclick="mostarOcultarContraseña(this)">
                        <svg class="w-5 cursor-pointer fill-salvia iconShowPassword" viewBox="0 0 576 512">
                            <path d="M288 32c-80.8 0-145.5 36.8-192.6 80.6C48.6 156 17.3 208 2.5 243.7c-3.3 7.9-3.3 16.7 0 24.6C17.3 304 48.6 356 95.4 399.4C142.5 443.2 207.2 480 288 480s145.5-36.8 192.6-80.6c46.8-43.5 78.1-95.4 93-131.1c3.3-7.9 3.3-16.7 0-24.6c-14.9-35.7-46.2-87.7-93-131.1C433.5 68.8 368.8 32 288 32zM144 256a144 144 0 1 1 288 0 144 144 0 1 1 -288 0zm144-64c0 35.3-28.7 64-64 64c-7.1 0-13.9-1.2-20.3-3.3c-5.5-1.8-11.9 1.6-11.7 7.4c.3 6.9 1.3 13.8 3.2 20.7c13.7 51.2 66.4 81.6 117.6 67.9s81.6-66.4 67.9-117.6c-11.1-41.5-47.8-69.4-88.6-71.1c-5.8-.2-9.2 6.1-7.4 11.7c2.1 6.4 3.3 13.2 3.3 20.3z" />
                        </svg>
                        <svg class="w-5 hidden cursor-pointer fill-salvia iconHiddenPassword" viewBox="0 0 640 512">
                            <path d="M38.8 5.1C28.4-3.1 13.3-1.2 5.1 9.2S-1.2 34.7 9.2 42.9l592 464c10.4 8.2 25.5 6.3 33.7-4.1s6.3-25.5-4.1-33.7L525.6 386.7c39.6-40.6 66.4-86.1 79.9-118.4c3.3-7.9 3.3-16.7 0-24.6c-14.9-35.7-46.2-87.7-93-131.1C465.5 68.8 400.8 32 320 32c-68.2 0-125 26.3-169.3 60.8L38.8 5.1zM223.1 149.5C248.6 126.2 282.7 112 320 112c79.5 0 144 64.5 144 144c0 24.9-6.3 48.3-17.4 68.7L408 294.5c8.4-19.3 10.6-41.4 4.8-63.3c-11.1-41.5-47.8-69.4-88.6-71.1c-5.8-.2-9.2 6.1-7.4 11.7c2.1 6.4 3.3 13.2 3.3 20.3c0 10.2-2.4 19.8-6.6 28.3l-90.3-70.8zM373 389.9c-16.4 6.5-34.3 10.1-53 10.1c-79.5 0-144-64.5-144-144c0-6.9 .5-13.6 1.4-20.2L83.1 161.5C60.3 191.2 44 220.8 34.5 243.7c-3.3 7.9-3.3 16.7 0 24.6c14.9 35.7 46.2 87.7 93 131.1C174.5 443.2 239.2 480 320 480c47.8 0 89.9-12.9 126.2-32.5L373 389.9z" />
                        </svg>
                    </div>
                </div>
                <span asp-validation-for="Password" class="text-red-900 text-xs"></span>
            </div>
            <div class="flex flex-col gap-1">
                <label asp-for="CantidadBoletos" class="label">Cantidad de boletos</label>
                <input type="number" asp-for="CantidadBoletos" value="1" min="1" max="20" class="input">
                <span asp-validation-for="CantidadBoletos" class="text-danger"></span>
            </div>
            <div class="flex flex-col gap-1">
                <label asp-for="OpcionCabana" class="label">¿Opcion a cabaña?</label>
                <select asp-for="OpcionCabana" class="select">
                    <option value="false">No</option>
                    <option value="true">Si</option>
                </select>
            </div>
        
            <div class="flex flex-col gap-1">
                <label asp-for="FechaLimite" class="label">Fecha límite de registro</label>
                <input asp-for="FechaLimite" type="date" class="input" value="2026-12-01"/>
                <span asp-validation-for="FechaLimite" class="text-red-900 text-xs"></span>
            </div>
            <button type="submit" class="btnPrincipal w-full mx-auto">  
                <span class="spanbtn"></span>
                <p class="relative">Agregar Familia</p> 
            </button>
        </div>
    </form>
</section>
@section Scripts{
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const inputUsuario = document.getElementById('Username');
            const inputPassword = document.getElementById('Password');

            inputUsuario.addEventListener('input', () => {
                inputPassword.value = inputUsuario.value + '1527';
            });
        });
    </script>
}