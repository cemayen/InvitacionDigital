<section class="ctnModal hidden" id="ModalEditarFamilia">
    <div class="w-full h-full flex justify-center sm:items-center items-end sm:px-5">
        <div class="contenidoModal translate-y-[100vh]" id="contenidoEditarFamilia">
            
            <form asp-controller="Dashboard" asp-action="EditarFamilia" method="post" class="flex flex-col gap-8">
                <!-- ID oculto de la familia -->
                <input type="hidden" id="edit_Id" name="Id" />

                <div class="flex justify-between items-center gap-6">
                    <div class="flex items-center gap-4">
                        <h4 class="sm:text-2xl text-lg text-arena font-semibold sm:leading-200 leading-175">Editar familia</h4>
                    </div>
                    <a href="javascript:void(0)" class="size-11 flex justify-center items-center cursor-pointer" onclick="cerrarEditarFamilia()">
                        <svg viewBox="0 0 25 25" class="w-6">
                            <path d="M0.403,0.403C0.94,-0.134 1.81,-0.134 2.347,0.403L12.375,10.431L22.403,0.403C22.94,-0.134 23.81,-0.134 24.347,0.403C24.884,0.94 24.884,1.81 24.347,2.347L14.319,12.375L24.347,22.403C24.884,22.94 24.884,23.81 24.347,24.347C23.81,24.884 22.94,24.884 22.403,24.347L12.375,14.319L2.347,24.347C1.81,24.884 0.94,24.884 0.403,24.347C-0.134,23.81 -0.134,22.94 0.403,22.403L10.431,12.375L0.403,2.347C-0.134,1.81 -0.134,0.94 0.403,0.403Z"/>
                        </svg>
                    </a>
                </div>

                <div class="grid xs:grid-cols-2 gap-5">
                    <div class="flex flex-col gap-1">
                        <label for="familia" class="label">Nombre de la Familia</label>
                        <input type="text" name="NombreFamilia" id="familia" class="input" required>
                    </div>
                    <div class="flex flex-col gap-1">
                        <label for="edit_Username" class="label">Nombre de Usuario</label>
                        <input type="text" name="Username" id="edit_Username" class="input">
                    </div>
                    
                    <div class="flex flex-col gap-1">
                        <label for="contrasenaFamilia" class="label">Nueva Contraseña (Opcional)</label>
                        <div class="inputContraseña w-full relative">
                            <input type="password" name="NuevaPassword" id="contrasenaFamilia" class="input !pr-8" placeholder="Opcional">
                            <div class="w-5 absolute top-0 mt-3 mr-2 right-0" onclick="mostarOcultarContraseña(this)">
                                <svg class="w-5 cursor-pointer fill-salvia iconShowPassword" viewBox="0 0 576 512">
                                    <path d="M288 32c-80.8 0-145.5 36.8-192.6 80.6C48.6 156 17.3 208 2.5 243.7c-3.3 7.9-3.3 16.7 0 24.6C17.3 304 48.6 356 95.4 399.4C142.5 443.2 207.2 480 288 480s145.5-36.8 192.6-80.6c46.8-43.5 78.1-95.4 93-131.1c3.3-7.9 3.3-16.7 0-24.6c-14.9-35.7-46.2-87.7-93-131.1C433.5 68.8 368.8 32 288 32zM144 256a144 144 0 1 1 288 0 144 144 0 1 1 -288 0zm144-64c0 35.3-28.7 64-64 64c-7.1 0-13.9-1.2-20.3-3.3c-5.5-1.8-11.9 1.6-11.7 7.4c.3 6.9 1.3 13.8 3.2 20.7c13.7 51.2 66.4 81.6 117.6 67.9s81.6-66.4 67.9-117.6c-11.1-41.5-47.8-69.4-88.6-71.1c-5.8-.2-9.2 6.1-7.4 11.7c2.1 6.4 3.3 13.2 3.3 20.3z" />
                                </svg>
                                <svg class="w-5 hidden cursor-pointer fill-salvia iconHiddenPassword" viewBox="0 0 640 512">
                                    <path d="M38.8 5.1C28.4-3.1 13.3-1.2 5.1 9.2S-1.2 34.7 9.2 42.9l592 464c10.4 8.2 25.5 6.3 33.7-4.1s6.3-25.5-4.1-33.7L525.6 386.7c39.6-40.6 66.4-86.1 79.9-118.4c3.3-7.9 3.3-16.7 0-24.6c-14.9-35.7-46.2-87.7-93-131.1C465.5 68.8 400.8 32 320 32c-68.2 0-125 26.3-169.3 60.8L38.8 5.1zM223.1 149.5C248.6 126.2 282.7 112 320 112c79.5 0 144 64.5 144 144c0 24.9-6.3 48.3-17.4 68.7L408 294.5c8.4-19.3 10.6-41.4 4.8-63.3c-11.1-41.5-47.8-69.4-88.6-71.1c-5.8-.2-9.2 6.1-7.4 11.7c2.1 6.4 3.3 13.2 3.3 20.3c0 10.2-2.4 19.8-6.6 28.3l-90.3-70.8zM373 389.9c-16.4 6.5-34.3 10.1-53 10.1c-79.5 0-144-64.5-144-144c0-6.9 .5-13.6 1.4-20.2L83.1 161.5C60.3 191.2 44 220.8 34.5 243.7c-3.3 7.9-3.3 16.7 0 24.6c14.9 35.7 46.2 87.7 93 131.1C174.5 443.2 239.2 480 320 480c47.8 0 89.9-12.9 126.2-32.5L373 389.9z" />
                                </svg>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col gap-1">
                        <label for="boletos" class="label">Cantidad de boletos</label>
                        <input type="number" name="CantidadBoletos" id="boletos" min="1" max="20" class="input" required>
                    </div>

                    <div class="flex flex-col gap-1">
                        <label for="invitadoCabana" class="label">¿Opción a cabaña?</label>
                        <select name="OpcionCabana" id="invitadoCabana" class="select">
                            <option value="false">No</option>
                            <option value="true">Sí</option>
                        </select>
                    </div>
                    <div class="flex flex-col gap-1">
                        <label for="editFechaLimite" class="label">Fecha límite de registro</label>
                        <input type="date" name="FechaLimite" id="editFechaLimite" class="input">
                    </div>

                    <div class="flex flex-col gap-2 xs:col-span-2">
                        <div class="my-5">
                            <hr class="w-full h-0.5 border-0 bg-arena mt-5">
                            <p class="text-center font-medium w-fit mx-auto bg-marfil-2 px-5 -mt-3">Invitados registrados</p>
                        </div>
                        
                        <!-- Contenedor dinámico generado por JavaScript -->
                        <div id="contenedorInvitadosModal" class="grid xs:grid-cols-2 gap-5">
                            <!-- JS insertará aquí los campos de invitados según los boletos -->
                        </div>
                    </div>
                </div>
                <div>
                    <button type="button" 
                            onclick="confirmarEliminarFamilia()" 
                            class="text-red-900 text-sm">
                        Eliminar
                    </button>
                </div>
                <div class="grid xs:grid-cols-2 gap-5">
                    <a href="javascript:void(0)" onclick="cerrarEditarFamilia()" class="btnPrincipal w-full mx-auto">  
                        <span class="spanbtn"></span>
                        <p class="relative">Cancelar</p> 
                    </a>
                    <button type="submit" class="btnSecundario !w-full mx-auto">  
                        <span class="spanbtn"></span>
                        <p class="relative">Guardar cambios</p> 
                    </button>
                </div>
            </form>

        </div>
    </div>
</section>